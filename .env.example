PORT=8080

# Origin allowed by CORS — the Next.js app's URL.
CLIENT_URL=

# Redis — must be the SAME instance as the Next.js app's REDIS_URL. The two
# communicate over pub/sub; different instances means notifications and live
# quiz events are published into the void. Redis protocol URL (rediss://...).
REDIS_URL=

# Neon PostgreSQL — the SAME database as the Next.js app's DATABASE_URL.
# This server writes QuizAttempt and AttemptAnswer rows when a live session ends.
DATABASE_URL=

# Must match AUTH_SECRET in the Next.js app: this server verifies the session
# JWE that the browser fetches from /api/auth/socket-token.
# NEXTAUTH_SECRET is read as a fallback if AUTH_SECRET is unset.
AUTH_SECRET=
